  { name: "Storage World Manchester Central", faction: "Camarilla / Anarch / Autarkis", revealed: false, desc: "An unremarkable self-storage facility east of the centre, quietly holding decades of Kindred secrets behind ordinary roller doors.", lat: 53.4838, lng: -2.2168, icon: "generic" },
  { name: "Crabtree Warehouse", faction: "", revealed: false, desc: "A disused warehouse in the light-industrial stretch near the Ashton Canal — empty, quiet, and occasionally not as unclaimed as it looks.", lat: 53.4790, lng: -2.1950, icon: "scene" },
  { name: "The Hallworth Gallery", faction: "", revealed: false, desc: "A small, exclusive gallery on King Street, showing expensive art to people who mostly just want something to hang in the office.", lat: 53.4809, lng: -2.2450, icon: "scene" },
