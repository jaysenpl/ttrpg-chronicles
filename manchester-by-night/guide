    { "featureType": "transit", "elementType": "labels.text.fill", "stylers": [ { "visibility": "simplified" }, { "hue": "#ff0000" } ] },
    { "featureType": "water", "elementType": "all", "stylers": [ { "color": "#070808" } ] }
];

const icons = {
  generic: { url: "data:image/png;base64,", width: 20, height: 40 },
  camarilla: { url: "data:image/png;base64,", width: 18, height: 40 },
  anarch: { url: "data:image/png;base64,", width: 21, height: 40 },
  scene: { url: "data:image/png;base64,", width: 26, height: 26 },
  mithras: { url: "data:image/png;base64,", width: 21, height: 40 },
};

const keyItems = [
  { icon: "camarilla", label: "Camarilla" },
  { icon: "anarch", label: "Anarch" },
  { icon: "mithras", label: "Unknown Faction" },
  { icon: "generic", label: "Unclaimed / Shared Ground" },
  { icon: "scene", label: "Location of Interest" },
];

function buildKey() {
  const container = document.getElementById("mapKey");
  keyItems.forEach(item => {
    const wrap = document.createElement("div");
    wrap.className = "key-item";
    const img = document.createElement("img");
    img.src = icons[item.icon].url;
    const span = document.createElement("span");
    span.textContent = item.label;
    wrap.appendChild(img);
    wrap.appendChild(span);
    container.appendChild(wrap);
  });
}
buildKey();

function initMap() {
  const map = new google.maps.Map(document.getElementById("map"), {
    styles: mapStyle,
    disableDefaultUI: false,
    streetViewControl: false,
    mapTypeControl: false
  });

  const bounds = new google.maps.LatLngBounds();
  const infoWindow = new google.maps.InfoWindow();

  locations.forEach(loc => {
    if (loc.revealed === false) return; // not shown until flipped to true

    const iconData = icons[loc.icon];

    const marker = new google.maps.Marker({
      map: map,
      position: { lat: loc.lat, lng: loc.lng },
      title: loc.name,
      icon: {
        url: iconData.url,
        scaledSize: new google.maps.Size(iconData.width, iconData.height),
        size: new google.maps.Size(iconData.width, iconData.height),
        anchor: new google.maps.Point(iconData.width / 2, iconData.height)
      }
    });

    bounds.extend(marker.getPosition());

    marker.addListener("click", () => {
      const factionLine = loc.faction
        ? `<p class="iw-faction">${loc.faction}</p>`
        : "";
      const swatchSize = loc.icon === "scene" ? 32 : 68;
      const iconSwatch = `<div style="display:inline-flex;align-items:center;justify-content:center;background:#1a0808;border:1px solid #b5121b;border-radius:6px;padding:6px;width:${swatchSize}px;height:${swatchSize}px;box-sizing:border-box;flex-shrink:0;">
        <img src="${iconData.url}" style="max-width:100%;max-height:100%;" />
      </div>`;
      infoWindow.setContent(
        `<div style="display:flex;gap:10px;align-items:flex-start;max-width:260px;">
           ${iconSwatch}
           <div>
             <p class="iw-title">${loc.name}</p>
             ${factionLine}
             <p class="iw-desc">${loc.desc}</p>
           </div>
         </div>`
      );
      infoWindow.open(map, marker);
    });
  });

  map.fitBounds(bounds, 40);
  window.__mbnMap = map;
  window.__mbnBounds = bounds;

  google.maps.event.addListenerOnce(map, "idle", () => {
    if (map.getZoom() > 15) map.setZoom(15);
  });
}

window.initMap = initMap;
</script>

