const mapStyle = [
    { "featureType": "administrative", "elementType": "labels", "stylers": [ { "visibility": "simplified" }, { "color": "#d20808" } ] },
    { "featureType": "landscape", "elementType": "all", "stylers": [ { "visibility": "on" }, { "gamma": "0.50" }, { "hue": "#ff2200" }, { "lightness": "-79" }, { "saturation": "-86" } ] },
