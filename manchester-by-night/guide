<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<title>Manchester by Night — Player Guide</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Special+Elite&family=Barlow+Condensed:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0d0a09; --panel:#1c1512; --panel2:#241a15; --line:#5c2318;
    --ink:#e9e0cd; --ink-dim:#c9bfa9; --ink-mute:#8a7d72;
    --accent:#8c3b28; --accent-soft:#5c2318; --accent-glow:rgba(140,59,40,.24);
    --blood:#5e1420; --gold:#c98a3e; --rain-solid:#7c8892;
    --serif:'Barlow Condensed',Georgia,'Times New Roman',serif;
    --display:'Cinzel',Georgia,serif;
    --mono:'Special Elite',monospace;
  }
  *{box-sizing:border-box;}
  html,body{margin:0; padding:0;}
  body{
    background:
      radial-gradient(ellipse at 20% 0%, #2a2320 0%, transparent 55%),
      repeating-linear-gradient(115deg, #100d0b 0px, #100d0b 2px, #14100d 2px, #14100d 4px),
      linear-gradient(180deg, #171310 0%, #0c0a08 100%);
    color:var(--ink); font-family:var(--serif); font-weight:500;
    line-height:1.6; font-size:17px;
  }
  a{color:var(--gold);}
  a:hover{color:var(--accent);}
  ::selection{background:var(--accent-soft); color:#fff;}

  /* ---- Brick-wall wrapper + pinned sheet ---- */
  .wall{ position:relative; max-width:900px; margin:0 auto; padding:24px 0 0; }
  .wall::before{
    content:""; position:absolute; inset:-24px -100vw; z-index:-1;
    background-image:
      repeating-linear-gradient(0deg, transparent 0 38px, rgba(0,0,0,0.35) 38px 40px),
      repeating-linear-gradient(90deg, #4a2620 0 78px, #452219 78px 80px);
    background-color:#5c2c22; opacity:0.38; filter:saturate(0.7);
  }
  .pin{
    position:absolute; width:14px; height:14px; border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #d8d2c4, var(--ink-dim) 60%, #6b6152 100%);
    box-shadow:0 3px 4px rgba(0,0,0,0.6); z-index:5;
  }
  .pin.left{ top:10px; left:26px; }
  .pin.right{ top:6px; right:30px; transform:rotate(12deg); }

  .sheet{
    position:relative; z-index:1; margin:0 16px;
    background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(0,0,0,0.08)), var(--bg);
    box-shadow:0 18px 50px rgba(0,0,0,0.65), 0 2px 0 rgba(255,255,255,0.03) inset;
    padding-bottom:120px;
    clip-path:polygon(
      0% 0%, 100% 0%, 100.0% 100%,
      94.1% 97.7%, 88.2% 97.5%, 82.4% 99.2%, 76.5% 98.2%, 70.6% 97.4%,
      64.7% 97.4%, 58.8% 98.2%, 52.9% 97.3%, 47.1% 98.4%, 41.2% 97.3%,
      35.3% 98.1%, 29.4% 98.5%, 23.5% 97.4%, 17.6% 98.8%, 11.8% 97.6%,
      5.9% 98.0%, 0.0% 100%
    );
  }
  .sheet::after{
    content:""; position:absolute; inset:0; pointer-events:none;
    background-image:
      repeating-linear-gradient(93deg, rgba(205,220,230,0.06) 0px, rgba(205,220,230,0.06) 1px, transparent 1px, transparent 8px),
      repeating-linear-gradient(89deg, rgba(205,220,230,0.035) 0px, rgba(205,220,230,0.035) 1px, transparent 1px, transparent 19px),
      repeating-linear-gradient(96deg, rgba(205,220,230,0.03) 0px, rgba(205,220,230,0.03) 2px, transparent 2px, transparent 43px),
      linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.12) 100%);
    mix-blend-mode:screen; opacity:0.6; z-index:2;
  }

  /* ---- Skyline header band ---- */
  .header-band{ position:relative; width:100%; height:260px; overflow:hidden; }
  .header-band svg{ position:absolute; inset:0; width:100%; height:100%; display:block; }
  .header-band::after{
    content:""; position:absolute; inset:0; pointer-events:none;
    background-image:repeating-linear-gradient(93deg, rgba(220,225,230,0.05) 0px, rgba(220,225,230,0.05) 1px, transparent 1px, transparent 12px);
    mix-blend-mode:screen;
  }
  .header-text{ position:absolute; top:22px; left:0; right:0; text-align:center; z-index:2; }
  h1.title{
    font-family:var(--display); font-weight:900; font-size:clamp(28px, 6.6vw, 46px);
    text-align:center; line-height:1.02; letter-spacing:.01em; margin:0; color:var(--ink);
    text-shadow:0 3px 10px rgba(0,0,0,0.85), 0 0 34px rgba(0,0,0,0.6);
  }
  .subtitle{
    display:block; text-align:center; font-family:var(--mono); font-size:15px;
    letter-spacing:.14em; color:var(--ink-dim); transform:rotate(-1.4deg); margin:6px 0 0;
    text-transform:uppercase; text-shadow:0 2px 8px rgba(0,0,0,0.85);
  }

  .content{ padding:28px 28px 0; position:relative; z-index:3; }

  .eyebrow-row{ display:flex; align-items:center; justify-content:center; gap:14px; margin:6px 0 6px; flex-wrap:wrap; }
  .wod-mark{ width:30px; height:30px; opacity:.95; }
  .eyebrow{
    font-family:var(--serif); font-weight:600; letter-spacing:.32em; font-size:11px;
    color:var(--rain-solid); text-transform:uppercase; text-align:center;
  }

  .rule{
    height:1px; width:100%;
    background:linear-gradient(90deg, transparent, var(--line) 15%, var(--accent) 50%, var(--line) 85%, transparent);
    margin:22px 0; opacity:.8;
  }

  .quote-block{ max-width:480px; margin:0 auto 4px; text-align:center; }
  .quote-block p{
    font-family:var(--display); font-weight:500; font-style:italic; font-size:16px;
    line-height:1.6; color:var(--ink-dim); margin:0 0 8px;
  }
  .quote-attr{ font-family:var(--serif); font-size:12.5px; letter-spacing:.2em; text-transform:uppercase; color:var(--rain-solid); display:block; text-align:center; }

  .faction-row{ display:flex; align-items:center; justify-content:center; gap:30px; margin:26px 0 6px; flex-wrap:wrap; }
  .faction{ display:flex; flex-direction:column; align-items:center; gap:8px; opacity:.92; }
  .ankh-slot{ height:46px; display:flex; align-items:flex-end; }
  .word-slot{ height:36px; display:flex; align-items:center; }
  .faction img.ankh{ height:46px; width:auto; filter:drop-shadow(0 0 10px rgba(0,0,0,0.5)); }
  .faction img.wordmark{ max-width:100px; max-height:36px; width:auto; height:auto; object-fit:contain; opacity:.9; }
  .versus{ font-family:var(--display); font-size:13px; letter-spacing:.3em; color:var(--rain-solid); text-transform:uppercase; }
  .pick-line{ text-align:center; font-family:var(--mono); font-size:12.5px; color:var(--ink-dim); letter-spacing:.05em; margin-top:4px; }

  nav.tabs{
    position:sticky; top:0; z-index:20;
    background:rgba(13,10,9,.94); backdrop-filter:blur(6px);
    border-top:1px solid var(--line); border-bottom:1px solid var(--line);
    display:flex; overflow-x:auto; -webkit-overflow-scrolling:touch; scrollbar-width:none;
  }
  nav.tabs::-webkit-scrollbar{display:none;}
  nav.tabs button{
    flex:0 0 auto; background:none; border:none; color:var(--ink-mute);
    font-family:var(--display); font-size:.7rem; letter-spacing:.14em; text-transform:uppercase;
    padding:15px 18px 12px; cursor:pointer; border-bottom:3px solid transparent;
    white-space:nowrap; transition:color .15s ease, border-color .15s ease;
  }
  nav.tabs button:hover{color:var(--ink);}
  nav.tabs button.active{color:var(--ink); border-bottom-color:var(--accent);}

  main{max-width:900px; margin:0 auto; padding:32px 0 10px;}
  section.panel{display:none;}
  section.panel.active{display:block; animation:fade .25s ease;}
  @keyframes fade{from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:none;}}

  h2.section-title{
    font-family:var(--display); font-weight:700; letter-spacing:.03em; font-size:1.35rem;
    color:var(--gold); margin:0 0 6px; padding-bottom:12px; border-bottom:1px solid var(--line);
  }
  h2.section-title .num{color:var(--accent); font-size:.85em; margin-right:8px;}
  h3{
    font-family:var(--display); font-weight:600; letter-spacing:.08em; font-size:.88rem;
    color:var(--ink); margin:30px 0 10px; text-transform:uppercase;
  }
  p{color:var(--ink); margin:0 0 14px; max-width:66ch; font-weight:400; font-size:1.05rem;}
  p.dim{color:var(--ink-dim);}
  .lede{font-size:1.1rem; color:var(--ink-dim); font-style:italic; margin-bottom:22px; font-family:var(--display); font-weight:500;}
  strong{color:var(--ink); font-weight:700;}

  .callout{
    background:rgba(140,59,40,0.07); border:1px solid var(--line); border-left:3px solid var(--accent);
    padding:16px 18px; margin:18px 0;
  }
  .callout.gold{border-left-color:var(--gold);}
  .callout h4{margin-top:0; color:var(--gold); font-size:.78rem; text-transform:uppercase; letter-spacing:.24em; font-family:var(--serif); font-weight:700;}
  .callout p:last-child{margin-bottom:0;}
  .callout p{font-size:1rem;}

  .resource-list{list-style:none; padding:0; margin:0;}
  .resource-list li{
    background:var(--panel); border:1px solid var(--line); border-radius:2px;
    padding:14px 16px; margin-bottom:10px; display:flex; flex-direction:column; gap:3px;
  }
  .resource-list .rtitle{color:var(--ink); font-weight:600;}
  .resource-list .rnote{color:var(--ink-mute); font-size:.88rem;}
  .tag{
    display:inline-block; font-family:var(--mono); font-size:.62rem; letter-spacing:.08em;
    text-transform:uppercase; color:var(--accent); border:1px solid var(--accent-soft);
    border-radius:20px; padding:2px 9px; margin-bottom:6px; width:max-content;
  }

  .index-grid{display:grid; grid-template-columns:1fr; gap:12px; margin-top:22px;}
  .index-card{
    background:var(--panel); border:1px solid var(--line); border-radius:2px; padding:18px 20px;
    display:flex; justify-content:space-between; align-items:center; gap:12px; cursor:pointer;
    transition:border-color .15s ease, transform .15s ease;
  }
  .index-card:hover{border-color:var(--accent); transform:translateX(2px);}
  .index-card .itxt h3{margin:0 0 4px; font-size:.95rem; letter-spacing:.05em; color:var(--ink); text-transform:none;}
  .index-card .itxt p{margin:0; font-size:.88rem; color:var(--ink-mute); max-width:46ch;}
  .index-card .arrow{color:var(--accent); font-family:var(--display); font-size:1.1rem; flex-shrink:0;}

  footer.site-footer{
    display:flex; flex-direction:column; align-items:center; gap:10px;
    text-align:center; padding:30px 20px 6px; border-top:1px solid var(--line);
  }
  footer.site-footer img{ height:30px; width:auto; opacity:.9; }
  footer.site-footer .credit{
    font-family:var(--serif); font-weight:600; font-size:12.5px; letter-spacing:.2em;
    text-transform:uppercase; color:var(--ink-mute);
  }

  /* --- Map panel --- */
  #map-panel #map {
    width: 100%; height: 640px; border: 1px solid var(--line);
    box-shadow: 0 0 40px var(--accent-glow); border-radius: 2px; background:#0a0a0a;
  }
  #map-panel .map-legend-note { margin: 12px 0 6px; font-size: 0.82rem; color: var(--ink-mute); text-align: center; line-height: 1.5; }
  #map-panel .key {
    margin: 0 0 8px; padding: 16px 4px 0; display: flex; flex-wrap: wrap;
    justify-content: center; gap: 20px 32px; border-top: 1px solid var(--line);
  }
  #map-panel .key-item { display: flex; align-items: center; gap: 10px; }
  #map-panel .key-item img { height: 30px; width: auto; filter: drop-shadow(0 0 3px var(--accent-glow)); }
  #map-panel .key-item span { font-family:var(--serif); font-size: 0.85rem; color: var(--ink-dim); letter-spacing: 0.3px; }
  @media (max-width: 600px) { #map-panel #map { height: 480px; } }
  .marker-icon { filter: drop-shadow(0 0 3px rgba(0,0,0,0.9)) drop-shadow(0 0 6px var(--accent-glow)); cursor: pointer; }
  .iw-title { font-family: Georgia, 'Times New Roman', serif; font-size: 1.05rem; color: #1a1a1a; margin: 0 0 4px; }
  .iw-faction { font-family: Georgia, 'Times New Roman', serif; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 1.2px; color: #8c3b28; margin: 0 0 8px; }
  .iw-desc { font-family: Georgia, 'Times New Roman', serif; font-size: 0.88rem; color: #333; line-height: 1.45; max-width: 240px; margin: 0; }

  @media (max-width:600px){
    .content{ padding:22px 18px 0; }
    .header-band{ height:200px; }
    .faction-row{ gap:18px; }
    .sheet{ margin:0 8px; }
  }
</style>
</head>
