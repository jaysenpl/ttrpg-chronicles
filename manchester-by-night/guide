/* ---------- Tab switching ---------- */
(function(){
  var tabs = document.querySelectorAll('nav.tabs button');
  var panels = document.querySelectorAll('section.panel');
  function show(name){
    tabs.forEach(function(b){ b.classList.toggle('active', b.dataset.tab === name); });
    panels.forEach(function(p){ p.classList.toggle('active', p.dataset.panel === name); });
    try{ sessionStorage.setItem('mbn_tab', name); }catch(e){}
    window.scrollTo({top:0, behavior:'instant'});
    if(name === 'map' && window.__mbnMap){
      google.maps.event.trigger(window.__mbnMap, 'resize');
      window.__mbnMap.fitBounds(window.__mbnBounds, 40);
    }
  }
  window.__mbnShowTab = show;
  tabs.forEach(function(b){ b.addEventListener('click', function(){ show(b.dataset.tab); }); });
  document.querySelectorAll('.index-card').forEach(function(c){
    c.addEventListener('click', function(){ show(c.dataset.goto); });
  });
  var start = 'index';
  try{
    var h = (location.hash || '').replace('#','');
    var saved = sessionStorage.getItem('mbn_tab');
    if(h && document.querySelector('[data-panel="'+h+'"]')) start = h;
    else if(saved && document.querySelector('[data-panel="'+saved+'"]')) start = saved;
  }catch(e){}
  if(start !== 'index') show(start);
})();

